# Flags passadas em toda chamada "codex exec".
# Padrão: sandbox restrito à pasta de trabalho, nunca pede aprovação
# (obrigatório pois roda sem terminal interativo), e permite rodar fora de um repo git.
EXEC_FLAGS=-s workspace-write -c approval_policy="never" --skip-git-repo-check

# Timeout por chamada, em segundos
EXEC_TIMEOUT_SECONDS=600
